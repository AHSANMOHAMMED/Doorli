{
  "name": "doorli",
  "version": "0.1.0",
  "packageManager": "npm@11.14.1",
  "private": true,
  "description": "Doorli — Everything Local. Delivered.",
  "author": {
    "name": "AHSAN MOHAMMED",
    "email": "ahsanmohammed828@gmail.com"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deploy": "bash scripts/deploy.sh",
    "db:migrate": "npm run migrate --workspace=@doorli/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@doorli/db",
    "db:seed": "npm run seed --workspace=@doorli/db",
    "db:generate": "npm run generate --workspace=@doorli/db",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.10",
    "@next/swc-linux-x64-musl": "16.2.10",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}
