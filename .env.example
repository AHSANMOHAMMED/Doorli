EXPO_PUBLIC_API_URL=http://localhost:4000

# Services
API_PORT=4000
AUTH_PORT=4001
DELIVERY_PORT=4002
NOTIFICATIONS_HEALTH_PORT=4007
SEARCH_PORT=4004
FORUM_SERVICE_URL=http://localhost:8087
GOV_SERVICE_URL=http://localhost:8089
EMERGENCY_SERVICE_URL=http://localhost:8088

# Kafka (optional, for search event consumer)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=doorli.events

# Internal Secrets
ERP_INTERNAL_SECRET=
SEARCH_SELF_URL=http://localhost:4004

# Platform
DEFAULT_CITY=Colombo
DEFAULT_RADIUS_KM=5

# AI Service
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
