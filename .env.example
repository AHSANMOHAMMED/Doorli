# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Mobile Builds
EXPO_TOKEN=

# CI/CD
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
OCI_HOST=
OCI_USER=
OCI_SSH_KEY=

# ERP
ERP_API_URL=
ERP_API_KEY=
ERP_EMBEDDED_URL=
# Enterprise ERPNext / Frappe integration (only for vendors with erpProvider=enterprise)
# Example: https://enterprise.doorli.me/api/method/doorli_core.api.create_order
ERP_ENTERPRISE_URL=
# Optional explicit provisioning endpoint; otherwise derived from ERP_ENTERPRISE_URL
ERP_ENTERPRISE_PROVISION_URL=
# Optional explicit product export endpoint; otherwise derived from ERP_ENTERPRISE_URL
ERP_ENTERPRISE_PRODUCT_SYNC_URL=
# Must match DOORLI_WEBHOOK_SECRET on the Enterprise OS node; use the existing ERP_INTERNAL_SECRET above
INTEGRATION_RECONCILIATION_INTERVAL_MS=60000
INTEGRATION_RECONCILIATION_BATCH=10
INTEGRATION_MAX_ATTEMPTS=8
# Optional URL used by the reconciliation worker when the API is behind a proxy.
INTEGRATION_RETRY_BASE_URL=
