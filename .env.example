GEMINI_MODEL=gemini-2.5-flash
AI_PORT=4006
AI_SERVICE_URL=http://localhost:4006
SEARCH_SERVICE_URL=http://localhost:4004
AUTH_SERVICE_URL=http://localhost:4001
DELIVERY_SERVICE_URL=http://localhost:8086
NOTIFICATIONS_SERVICE_URL=http://localhost:4007
FORUM_SERVICE_URL=http://localhost:8087
EMERGENCY_SERVICE_URL=http://localhost:8088
