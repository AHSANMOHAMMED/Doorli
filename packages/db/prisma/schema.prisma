  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
  @@map("posts")
}

model ForumModerator {
  id        String   @id @default(uuid()) @db.Uuid
  forumId   String   @map("forum_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  grantedBy String   @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  forum   Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user    User  @relation("UserAsModerator", fields: [userId], references: [id])
  granter User  @relation("UserGrantedModerator", fields: [grantedBy], references: [id])

  @@unique([forumId, userId])
  @@map("forum_moderators")
}

model ReputationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int
  reason    String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reputation_records")
}

model ForumBan {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  forumId   String?   @map("forum_id") @db.Uuid // null = global ban
  reason    String    @db.VarChar(200)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("forum_bans")
}

// ==========================================
// Emergency Response Domain
// ==========================================

model Incident {
  id          String                                 @id @default(uuid()) @db.Uuid
  reporterId  String                                 @map("reporter_id") @db.Uuid
  type        String                                 @db.VarChar(50) // fire, medical, police, etc.
  description String?
  latitude    Decimal                                @db.Decimal(10, 8)
  longitude   Decimal                                @db.Decimal(11, 8)
  location    Unsupported("GEOGRAPHY(POINT, 4326)")?
  status      ServiceRequestStatus                   @default(open)
  mediaUrls   Json?                                  @map("media_urls")
  isAnonymous Boolean                                @default(false) @map("is_anonymous")
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  reporter   User       @relation("IncidentReporter", fields: [reporterId], references: [id])
  dispatches Dispatch[]

  @@index([reporterId])
  @@index([status])
  @@map("incidents")
}

model Alert {
  id        String                                   @id @default(uuid()) @db.Uuid
  senderId  String                                   @map("sender_id") @db.Uuid
  type      String                                   @db.VarChar(50)
  priority  String                                   @db.VarChar(20) // info, warning, critical
  message   String
  geofence  Unsupported("GEOGRAPHY(POLYGON, 4326)")?
  status    String                                   @default("active") @db.VarChar(20)
  createdAt DateTime                                 @default(now()) @map("created_at")
  expiresAt DateTime?                                @map("expires_at")

  sender User @relation("AlertSender", fields: [senderId], references: [id])

  @@index([senderId])
  @@map("emergency_alerts")
}

model SOSRecord {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @map("user_id") @db.Uuid
  latitude     Decimal                                @db.Decimal(10, 8)
  longitude    Decimal                                @db.Decimal(11, 8)
  location     Unsupported("GEOGRAPHY(POINT, 4326)")?
  status       String                                 @default("active") @db.VarChar(20)
  recordingUrl String?                                @map("recording_url")
  createdAt    DateTime                               @default(now()) @map("created_at")
  resolvedAt   DateTime?                              @map("resolved_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sos_records")
}

model Dispatch {
  id           String    @id @default(uuid()) @db.Uuid
  incidentId   String    @map("incident_id") @db.Uuid
  responderId  String    @map("responder_id") @db.Uuid
  status       String    @default("assigned") @db.VarChar(20)
  dispatchedAt DateTime  @default(now()) @map("dispatched_at")
  arrivedAt    DateTime? @map("arrived_at")
  completedAt  DateTime? @map("completed_at")

  incident  Incident @relation(fields: [incidentId], references: [id])
  responder User     @relation("IncidentResponder", fields: [responderId], references: [id])

  @@index([incidentId])
  @@index([responderId])
  @@map("dispatches")
}

// -----------------------------------------
// GovTech Domain
// -----------------------------------------

model GovernmentService {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String
  category    String // e.g., "tax", "permit", "license"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permits     Permit[]
  licenses    License[]
  taxPayments TaxPayment[]
  complaints  Complaint[]

  @@map("government_services")
}

model TaxPayment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("pending") @db.VarChar(20) // pending, completed, failed
  taxPeriod String   @map("tax_period") @db.VarChar(50) // e.g., "2023-Q1"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id])
  service GovernmentService @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@map("tax_payments")
}

model License {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  serviceId String    @map("service_id") @db.Uuid
  licenseNo String    @unique @map("license_no") @db.VarChar(100)
  status    String    @default("active") @db.VarChar(20) // active, expired, suspended
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  user    User              @relation(fields: [userId], references: [id])
  service GovernmentService @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@map("licenses")
}

model Permit {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  serviceId String    @map("service_id") @db.Uuid
  permitNo  String    @unique @map("permit_no") @db.VarChar(100)
  status    String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  issuedAt  DateTime? @map("issued_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id])
  service GovernmentService @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@map("permits")
}

model Complaint {
  id          String                                 @id @default(uuid()) @db.Uuid
  userId      String                                 @map("user_id") @db.Uuid
  serviceId   String?                                @map("service_id") @db.Uuid
  title       String
  description String
  status      String                                 @default("open") @db.VarChar(20) // open, in_progress, resolved, closed
  category    String                                 @db.VarChar(50) // e.g., "infrastructure", "sanitation"
  location    Unsupported("GEOGRAPHY(POINT, 4326)")?
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  user    User               @relation(fields: [userId], references: [id])
  service GovernmentService? @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@map("complaints")
}

model DocumentVault {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  documentName String   @map("document_name")
  documentType String   @map("document_type") // e.g., "id_card", "tax_return", "proof_of_address"
  fileUrl      String   @map("file_url") // S3/GCS URL
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("document_vaults")
}

model PublicConsultation {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      String   @default("open") @db.VarChar(20) // open, closed
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  comments ConsultationComment[]

  @@map("public_consultations")
}

model ConsultationComment {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  consultation PublicConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([userId])
  @@map("consultation_comments")
}

// -----------------------------------------
// Platform Feature Management
// -----------------------------------------

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100) // e.g. "ai_reviews", "pos_integration"
  name        String   @db.VarChar(150)
  description String?
  isGlobal    Boolean  @default(false) @map("is_global") // If true, enabled for everyone automatically
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendorFeatures VendorFeature[]

  @@map("feature_flags")
}

model VendorFeature {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  featureId String   @map("feature_id") @db.Uuid
  isEnabled Boolean  @default(true) @map("is_enabled") // If the record exists, usually it means granted, but this allows explicit revoking of a global feature
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendor  Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([vendorId, featureId])
  @@index([vendorId])
  @@index([featureId])
  @@map("vendor_features")
}

// ==========================================
// Chat Domain
// ==========================================

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  content        String
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@map("chat_messages")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  vendorId  String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model GroupOrder {
  id         String   @id @default(uuid()) @db.Uuid
  createdBy  String   @db.Uuid
  vendorId   String   @db.Uuid
  title      String
  status     String   @default("open")
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creator User             @relation(fields: [createdBy], references: [id])
  vendor  Vendor           @relation(fields: [vendorId], references: [id])
  items   GroupOrderItem[]

  @@index([inviteCode])
  @@index([createdBy])
}

model GroupOrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  groupOrderId String   @db.Uuid
  userId       String   @db.Uuid
  productId    String   @db.Uuid
  quantity     Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())

  groupOrder GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([groupOrderId])
}

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  subject     String
  description String
  category    String   @default("general")
  status      String   @default("open")
  priority    String   @default("medium")
  assignedTo  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  responses TicketResponse[]

  @@index([userId])
  @@index([status])
}

model TicketResponse {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  senderId   String   @db.Uuid
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
}

model CorporateAccount {
  id           String   @id @default(uuid()) @db.Uuid
  companyName  String
  companyEmail String   @unique
  contactPhone String
  addressLine  String?
  city         String?
  taxId        String?
  creditLimit  Decimal  @default(0) @db.Decimal(12, 2)
  creditUsed   Decimal  @default(0) @db.Decimal(12, 2)
  status       String   @default("active")
  approvedBy   String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users  CorporateUser[]
  orders Order[]

  @@index([status])
}

model CorporateUser {
  id           String   @id @default(uuid()) @db.Uuid
  corporateId  String   @db.Uuid
  userId       String   @db.Uuid
  role         String   @default("member")
  department   String?
  monthlyLimit Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  corporate CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corporateId, userId])
  @@index([corporateId])
}

// ==========================================
// Centralized Super-Admin Control Plane
// ==========================================

model MaintenanceWindow {
  id        String    @id @default(uuid()) @db.Uuid
  active    Boolean   @default(false)
  message   String?
  reason    String?
  scope     String    @default("all") // all | marketplace | erp | <service-key>
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdBy String?   @map("created_by") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@map("maintenance_windows")
}

model RateLimitPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  path      String   @unique @db.VarChar(200) // route pattern or 'global'
  windowMs  Int      @default(900000) @map("window_ms")
  limit     Int      @default(500)
  notes     String?  @db.VarChar(300)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rate_limit_policies")
}

model ServiceState {
  key       String   @id @db.VarChar(50) // marketplace | delivery | auth | ...
  enabled   Boolean  @default(true)
  notes     String?  @db.VarChar(300)
  updatedBy String?  @map("updated_by") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_states")
}

model ControlAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String   @db.VarChar(100) // email or 'system'
  action     String   @db.VarChar(100) // e.g. maintenance.on, quota.set
  category   String?  @db.VarChar(50) // feature | maintenance | quota | tenant | module | broadcast | rate_limit | service
  targetType String   @map("target_type") @db.VarChar(50) // tenant | vendor | service | global
  targetId   String?  @map("target_id") @db.VarChar(100)
  summary    String   @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([createdAt])
  @@map("control_audit")
}
