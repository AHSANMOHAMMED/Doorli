generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  customer
  vendor
  driver
  admin
}

enum RideStatus {
  searching
  assigned
  arrived
  in_transit
  completed
  cancelled
}

enum VendorCategory {
  grocery
  restaurant
  hotel
  hall
  service
  beauty
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  picked_up
  delivered
  cancelled
}

enum OrderType {
  delivery
  pickup
  pos
}

/// Which ERP backend a vendor is wired to.
/// - none: not linked to any ERP
/// - simple: embedded Retail Smart ERP (Next app on the marketplace node)
/// - enterprise: isolated Frappe/ERPNext company (Doorli Enterprise OS)
enum ErpProvider {
  none
  simple
  enterprise
}

/// Provisioning lifecycle for an enterprise vendor's ERP company.
enum ErpProvisionStatus {
  none
  pending
  provisioned
  failed
}

/// Marketplace → ERP order sync outcome.
enum ErpSyncStatus {
  pending
  synced
  failed
  skipped
}

enum PaymentMethod {
  card
  wallet
  cod
  cash
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum BookingType {
  hotel
  hall
  beauty
  service
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum ServiceRequestStatus {
  open
  assigned
  in_progress
  completed
  cancelled
}

enum VehicleType {
  bike
  car
  van
  truck
}

enum PaymentReferenceType {
  order
  booking
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("LKR") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  walletId        String   @map("wallet_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(150)
  type            String   @db.VarChar(40)
  amount          Decimal  @db.Decimal(12, 2)
  balanceAfter    Decimal  @map("balance_after") @db.Decimal(12, 2)
  currency        String   @default("LKR") @db.VarChar(10)
  reference      String?  @db.VarChar(150)
  description    String?  @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  journalEntries WalletJournalEntry[]

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Biller {
  id        String        @id @db.VarChar(50)
  name      String        @db.VarChar(120)
  type      String        @db.VarChar(30)
  logo      String?
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  payments  BillPayment[]

  @@index([type, isActive])
  @@map("billers")
}

model BillPayment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  billerId       String   @map("biller_id") @db.VarChar(50)
  accountRef     String   @map("account_ref") @db.VarChar(150)
  amount         Decimal  @db.Decimal(12, 2)
  type           String   @db.VarChar(30)
  status         String   @default("pending") @db.VarChar(20)
  reference      String   @unique @db.VarChar(80)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(150)
  providerRef    String?  @map("provider_ref") @db.VarChar(150)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  biller         Biller   @relation(fields: [billerId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("bill_payments")
}

model WalletJournalEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  accountRef    String   @map("account_ref") @db.VarChar(150)
  accountType   String   @map("account_type") @db.VarChar(30)
  direction     String   @db.VarChar(10)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("LKR") @db.VarChar(10)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountType, accountRef, createdAt])
  @@map("wallet_journal_entries")
}

model LoyaltyPoint {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  points    Int      @default(0)
  earned    Int      @default(0)
  redeemed  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loyalty_points")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(100)
  username         String?  @unique @db.VarChar(50)
  phone            String?  @unique @db.VarChar(20)
  email            String?  @unique @db.VarChar(150)
  passwordHash     String?  @map("password_hash")
  role             UserRole @default(customer)
  profilePhotoUrl  String?  @map("profile_photo_url")
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(100)
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  locality         String?  @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  addresses           Address[]
  billPayments        BillPayment[]
  prescriptions       Prescription[]
  medicineOrders      MedicineOrder[]
  familyProfiles      FamilyProfile[]
  kycCases            KycCase[]
  walletTopups        WalletTopupIntent[]
  vendor              Vendor?
  driver              Driver?
  wallet              Wallet?
  walletTransactions  WalletTransaction[]
  loyaltyPoints       LoyaltyPoint?
  ordersAsCustomer    Order[]              @relation("CustomerOrders")
  ordersAsDriver      Order[]              @relation("DriverOrders")
  corporateUsers      CorporateUser[]
  bookings            Booking[]
  serviceRequests     ServiceRequest[]     @relation("CustomerServiceRequests")
  assignedServiceJobs ServiceRequest[]     @relation("ProviderServiceRequests")
  reviews             Review[]
  payments            Payment[]
  savedPaymentMethods SavedPaymentMethod[]
  notifications       Notification[]
  ridesAsCustomer     RideRequest[]        @relation("CustomerRides")
  deviceTokens        DeviceToken[]

  // Forum Domain Relations
  threads            Thread[]
  posts              Post[]
  moderatedForums    ForumModerator[]   @relation("UserAsModerator")
  grantedModerations ForumModerator[]   @relation("UserGrantedModerator")
  reputationRecords  ReputationRecord[]
  forumBans          ForumBan[]
  communityPosts     CommunityPost[]
  groupMemberships   GroupMembership[]
  moderationFlags    ModerationFlag[]
  premiumSubscription PremiumSubscription?
  aiSessions         AISession[]
  transitTickets     TransitTicket[]
  autoTopupRules     AutoTopupRule[]
  walletPayouts      WalletPayout[]
  journalEntries     WalletJournalEntry[]

  // Support Domain Relations
  supportTickets  SupportTicket[]
  ticketResponses TicketResponse[]

  // Emergency Domain Relations
  reportedIncidents Incident[]  @relation("IncidentReporter")
  sentAlerts        Alert[]     @relation("AlertSender")
  sosRecords        SOSRecord[]
  dispatches        Dispatch[]  @relation("IncidentResponder")

  // GovTech Relations
  taxPayments          TaxPayment[]
  licenses             License[]
  permits              Permit[]
  complaints           Complaint[]
  documents            DocumentVault[]
  consultationComments ConsultationComment[]

  // Chat Domain Relations
  chatConversations ConversationParticipant[]
  sentMessages      ChatMessage[]

  wishlistItems         Wishlist[]
  groupOrderMemberships GroupOrder[]
  groupOrderItems       GroupOrderItem[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model FamilyProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(100)
  relationship  String   @db.VarChar(40)
  phone         String?  @db.VarChar(20)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  preferences   Json?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isDefault])
  @@map("family_profiles")
}

model KycCase {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  level           Int       @default(1)
  status          String    @default("pending") @db.VarChar(20)
  idNumberHash    String?   @map("id_number_hash") @db.VarChar(128)
  documentUrl     String?   @map("document_url")
  rejectionReason String?   @map("rejection_reason")
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, level])
  @@map("kyc_cases")
}

model WalletTopupIntent {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  amount               Decimal  @db.Decimal(12, 2)
  method               String   @db.VarChar(20)
  status               String   @default("requires_payment") @db.VarChar(30)
  idempotencyKey       String   @map("idempotency_key") @db.VarChar(150)
  providerTransactionId String? @map("provider_transaction_id") @db.VarChar(150)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@map("wallet_topup_intents")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String?  @db.VarChar(50)
  addressLine String   @map("address_line")
  city        String?  @db.VarChar(80)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Vendor {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name") @db.VarChar(150)
  category           VendorCategory
  description        String?
  logoUrl            String?            @map("logo_url")
  bannerUrl          String?            @map("banner_url")
  phone              String?            @db.VarChar(20)
  addressLine        String?            @map("address_line")
  city               String?            @db.VarChar(80)
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  openingHours       Json?              @map("opening_hours")
  isOpen             Boolean            @default(true) @map("is_open")
  isVerified         Boolean            @default(false) @map("is_verified")
  avgRating          Decimal            @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews       Int                @default(0) @map("total_reviews")
  deliveryRadiusKm   Int                @default(5) @map("delivery_radius_km")
  minOrderAmount     Decimal?           @map("min_order_amount") @db.Decimal(10, 2)
  erpTenantId        String?            @map("erp_tenant_id") @db.VarChar(50)
  erpProvider        ErpProvider        @default(none) @map("erp_provider")
  erpProvisionStatus ErpProvisionStatus @default(none) @map("erp_provision_status")
  erpProvisionError  String?            @map("erp_provision_error") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  productAliases ProductAlias[]
  orders         Order[]
  bookings       Booking[]
  hotelRooms     HotelRoom[]
  hallSlots      HallSlot[]
  beautyServices BeautyService[]
  reviews        Review[]
  features       VendorFeature[]
  groupOrders    GroupOrder[]

  @@index([category])
  @@index([latitude, longitude])
  @@index([isOpen, isVerified])
  @@map("vendors")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  name          String   @db.VarChar(200)
  description   String?
  category      String?  @db.VarChar(100)
  barcode       String?  @db.VarChar(64)
  sku           String?  @db.VarChar(64)
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(10, 2)
  unit          String?  @db.VarChar(50)
  stockQuantity Int      @default(0) @map("stock_quantity")
  lowStockAt    Int      @default(5) @map("low_stock_at")
  imageUrl      String?  @map("image_url")
  isAvailable   Boolean  @default(true) @map("is_available")
  prepTimeMins  Int?     @map("prep_time_mins")
  addons        Json? // [{name, price}] for food customization
  allergens     Json? // string[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  aliases         ProductAlias[]
  wishlistItems   Wishlist[]
  groupOrderItems GroupOrderItem[]

  @@unique([vendorId, barcode])
  @@index([vendorId])
  @@index([isAvailable])
  @@index([category])
  @@index([barcode])
  @@map("products")
}

/**
 * Vendor-local / supplier / slang names that map to a catalog product
 */
model ProductAlias {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  alias     String   @db.VarChar(200)
  /**
   * Normalized form used for exact matching
   */
  aliasKey  String   @map("alias_key") @db.VarChar(220)
  createdAt DateTime @default(now()) @map("created_at")

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, aliasKey])
  @@index([vendorId])
  @@index([productId])
  @@map("product_aliases")
}

model Order {
  id                    String         @id @default(uuid()) @db.Uuid
  orderNumber           String         @unique @map("order_number") @db.VarChar(20)
  customerId            String         @map("customer_id") @db.Uuid
  vendorId              String         @map("vendor_id") @db.Uuid
  driverId              String?        @map("driver_id") @db.Uuid
  deliveryAddressId     String?        @map("delivery_address_id") @db.Uuid
  status                OrderStatus    @default(pending)
  orderType             OrderType      @default(delivery) @map("order_type")
  subtotal              Decimal        @db.Decimal(10, 2)
  deliveryFee           Decimal        @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount        Decimal        @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount           Decimal        @map("total_amount") @db.Decimal(10, 2)
  paymentMethod         PaymentMethod  @default(cod) @map("payment_method")
  paymentStatus         PaymentStatus  @default(pending) @map("payment_status")
  estimatedDeliveryTime Int?           @map("estimated_delivery_time")
  specialInstructions   String?        @map("special_instructions")
  erpOrderId            String?        @map("erp_order_id") @db.VarChar(50)
  erpSyncStatus         ErpSyncStatus? @map("erp_sync_status")
  erpSyncError          String?        @map("erp_sync_error") @db.Text
  erpSyncedAt           DateTime?      @map("erp_synced_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  customer        User              @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  driver          User?             @relation("DriverOrders", fields: [driverId], references: [id])
  deliveryAddress Address?          @relation(fields: [deliveryAddressId], references: [id])
  corporate       CorporateAccount? @relation(fields: [corporateId], references: [id])
  corporateId     String?           @map("corporate_id") @db.Uuid
  items           OrderItem[]
  reviews         Review[]

  @@index([customerId])
  @@index([vendorId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  notes      String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  bookingNumber String        @unique @map("booking_number") @db.VarChar(20)
  customerId    String        @map("customer_id") @db.Uuid
  vendorId      String        @map("vendor_id") @db.Uuid
  bookingType   BookingType   @map("booking_type")
  checkInDate   DateTime?     @map("check_in_date") @db.Date
  checkOutDate  DateTime?     @map("check_out_date") @db.Date
  eventDate     DateTime?     @map("event_date") @db.Date
  startTime     DateTime?     @map("start_time") @db.Time
  endTime       DateTime?     @map("end_time") @db.Time
  guestCount    Int?          @map("guest_count")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  depositAmount Decimal?      @map("deposit_amount") @db.Decimal(10, 2)
  status        BookingStatus @default(pending)
  requirements  String?
  durationMins  Int?          @map("duration_mins")
  roomType      String?       @map("room_type") @db.VarChar(100)
  roomId        String?       @map("room_id") @db.Uuid
  hallSlotId    String?       @map("hall_slot_id") @db.Uuid
  beautyServiceId String?      @map("beauty_service_id") @db.Uuid
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(150)
  amenities     Json?
  contractUrl   String?       @map("contract_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id])
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  room     HotelRoom? @relation(fields: [roomId], references: [id])
  hallSlot HallSlot? @relation(fields: [hallSlotId], references: [id])
  beautyService BeautyService? @relation(fields: [beautyServiceId], references: [id])

  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([hallSlotId, eventDate])
  @@index([beautyServiceId, eventDate])
  @@unique([customerId, idempotencyKey])
  @@map("bookings")
}

model HotelRoom {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String    @map("vendor_id") @db.Uuid
  roomType    String    @map("room_type") @db.VarChar(100)
  description String?
  capacity    Int       @default(2)
  totalRooms  Int       @default(1) @map("total_rooms")
  price       Decimal   @db.Decimal(12, 2)
  amenities   Json?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@unique([vendorId, roomType])
  @@index([vendorId, isActive])
  @@map("hotel_rooms")
}

model HallSlot {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String    @map("vendor_id") @db.Uuid
  name        String    @db.VarChar(100)
  slotType    String    @map("slot_type") @db.VarChar(30)
  capacity    Int
  price       Decimal   @db.Decimal(12, 2)
  amenities   Json?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
  @@map("hall_slots")
}

model BeautyService {
  id           String    @id @default(uuid()) @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  name         String    @db.VarChar(120)
  description  String?
  durationMins Int       @map("duration_mins")
  price        Decimal   @db.Decimal(12, 2)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
  @@map("beauty_services")
}

model ServiceRequest {
  id                 String               @id @default(uuid()) @db.Uuid
  customerId         String               @map("customer_id") @db.Uuid
  assignedProviderId String?              @map("assigned_provider_id") @db.Uuid
  serviceType        String               @map("service_type") @db.VarChar(100)
  title              String               @db.VarChar(200)
  description        String?
  addressLine        String?              @map("address_line")
  latitude           Decimal?             @db.Decimal(10, 8)
  longitude          Decimal?             @db.Decimal(11, 8)
  isUrgent           Boolean              @default(false) @map("is_urgent")
  offeredRate        Decimal?             @map("offered_rate") @db.Decimal(10, 2)
  status             ServiceRequestStatus @default(open)
  scheduledAt        DateTime?            @map("scheduled_at")
