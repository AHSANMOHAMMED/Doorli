{
  "name": "@doorli/erp",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-server.mjs && node scripts/dev-server.mjs",
    "dev:next": "next dev",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "prebuild": "npm run validate:migrations",
    "postbuild": "node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node -e \"console.log('Starting Doorli POS...'); if (process.env.SKIP_MIGRATIONS !== 'true') { const { execSync } = require('child_process'); console.log('Running database migrations...'); try { execSync('npm run db:migrate', { stdio: 'inherit' }); console.log('Migrations completed successfully'); } catch(e) { console.error('Migration failed:', e.message); if (process.env.REQUIRE_MIGRATIONS === 'true') { console.error('Migrations required - exiting'); process.exit(1); } else { console.warn('Continuing without migrations (database may already be up to date)...'); } } } process.exit(0);\" && node server.js",
    "start:next": "next start -H 0.0.0.0",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:seed-admin": "npx tsx scripts/create-super-admin.ts",
    "db:indexes": "npx tsx stress-tests/scripts/apply-indexes.ts",
    "stress:all": "node stress-tests/scripts/run-all-tests.js",
    "stress:quick": "node stress-tests/scripts/run-all-tests.js --quick",
    "stress:http": "k6 run stress-tests/k6/comprehensive-load-test.js",
    "stress:ws": "k6 run stress-tests/k6/websocket-stress-test.js",
    "stress:pos": "k6 run stress-tests/k6/pos-checkout-test.js",
    "stress:spike": "k6 run -e SPIKE_TEST=true stress-tests/k6/pos-checkout-test.js",
    "stress:artillery": "npx artillery run stress-tests/artillery/http-load-test.yml",
    "stress:artillery:ws": "npx artillery run stress-tests/artillery/websocket-load-test.yml",
    "stress:setup-data": "npx tsx stress-tests/scripts/setup-test-data.ts",
    "stress:simple": "node stress-tests/scripts/simple-test.js",
    "validate:migrations": "node scripts/validate-migration-numbers.js",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test e2e/tests/smoke/",
    "test:e2e:critical": "npx playwright test e2e/tests/critical/",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:workflows": "npx playwright test --project=workflows",
    "test:e2e:ui-workflows": "npx playwright test --project=ui-workflows",
    "ci": "npm run lint && npm run validate:migrations && npm run build",
    "postinstall": "if [ -d node_modules/next-auth ]; then patch-package; else echo 'Skipping next-auth patch (package not locally installed)'; fi && node scripts/patch-next-app-route-context.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.8.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.1",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.5",
    "three": "^0.170.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
